# Copy this file to .env and adjust values.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: DB_BACKEND=sqlite (DB_NAME is the file path) or DB_BACKEND=postgres
DB_BACKEND=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Seeding: seed_users refuses to run without this (and only when DEBUG=True)
SEED_DEFAULT_PASSWORD=

# Session / lockout tuning
SESSION_IDLE_TIMEOUT=1800
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=300
MAX_DASHBOARD_CARDS=8

# Front desk (Phase 2)
TIME_ZONE=UTC
PATIENT_CODE_PREFIX=PAT
APPOINTMENT_CODE_PREFIX=APT
CODE_SEQUENCE_DIGITS=6
CODE_SEQUENCE_START=1
PHONE_REGEX=^\+?[0-9][0-9\- ]{6,19}$
PAGE_SIZE=15
APPOINTMENT_SLOT_MINUTES=30
APPOINTMENT_CANCELLATION_WINDOW_MINUTES=120
